# ddiver-fb brain. Copy to .env next to docker-compose.yml (/srv/ddiver-fb on the VPS), chmod 600.
# Nothing in this file is a secret; every real value is.

# A NEW bot from @BotFather — not ddiver's, and not the collector's owner-only alert bot.
BOT_TOKEN=
# my.telegram.org -> API development tools (the bot talks MTProto, like ddiver's).
API_ID=
API_HASH=
# Your Telegram user id: the owner, allowed automatically, the only one who sees the collector.
OWNER_ID=
# The collector's bearer token: `openssl rand -hex 32`. The same value goes into the collector's
# <root>/secrets as FBC_INGEST_TOKEN. At least 32 characters.
INGEST_TOKEN=

# Optional ------------------------------------------------------------------------------------
# The zone of the collector's day (offline and silence alerts only fire in the daytime);
# unset: your own timezone from the bot's settings.
# COLLECTOR_TZ=Europe/Sofia
# DAY_START_HOUR=8
# DAY_END_HOUR=23
# OFFLINE_AFTER_MINUTES=20
# Dead-man's switch, pinged once a minute (healthchecks.io, Uptime Kuma push, ...).
# PING_URL=
# LOG_FORMAT=json
# METRICS_HOST=0.0.0.0
# METRICS_PORT=0
