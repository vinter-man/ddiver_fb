# ssh client config for the collector's tunnel (used only with `-F`, never ~/.ssh/config).
# Keep this file and the key 0600. VPS_HOST (and Port, when it is not 22) come from the pinned
# host key: on the Mac, deploy/macos/setup-fbc-user.sh writes both from the one line the owner
# pins (RUNBOOK section 9); on Linux, replace VPS_HOST by hand and put that line, checked against
# the VPS console, in the known_hosts file below. Only the VPS's ed25519 host key is accepted,
# from that file alone; no agent's keys are offered, only the tunnel's own.
#
# The local end is a Unix socket in this account's own .ssh directory (0700; %d is the home,
# which the Mac's setup writes out), owner-only and replaced when a stale one is left: no other
# local account can create it or connect to it. On a loopback TCP port, any account could bind
# it while ssh is down, and the collector would hand that account the bearer token. The
# collector goes through it with FBC_INGEST_SOCKET=<home>/.ssh/fbtunnel.sock and
# FBC_INGEST_URL=http://127.0.0.1:8781 (the brain's address at the far end).

Host fbtunnel
    HostName VPS_HOST
    User fbtunnel
    Port 22
    IdentityFile ~/.ssh/fbtunnel_ed25519
    IdentitiesOnly yes
    IdentityAgent none
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/fbtunnel_known_hosts
    GlobalKnownHostsFile /dev/null
    HostKeyAlgorithms ssh-ed25519
    UpdateHostKeys no
    CheckHostIP no
    ConnectTimeout 20
    ExitOnForwardFailure yes
    ServerAliveInterval 15
    ServerAliveCountMax 3
    LocalForward %d/.ssh/fbtunnel.sock 127.0.0.1:8781
    StreamLocalBindMask 0177
    StreamLocalBindUnlink yes
    RequestTTY no
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings no
